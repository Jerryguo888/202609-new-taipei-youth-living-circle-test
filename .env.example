# Variables consumed by compose.yml. Copy to .env for local Docker runs:
#   cp .env.example .env
# On the server, CI passes these as environment variables instead, so no .env
# file is required there.

# CARTO basemap API key, inlined into the bundle at build time.
# Leave empty to build against the free/watermarked tier.
# In CI this comes from the VITE_CARTO_KEY repo secret.
VITE_CARTO_KEY=

# Image name/tag built by compose. There is no port setting here: compose.yml
# publishes 8080 on the host directly.
IMAGE_NAME=nt-youth-living-circle
IMAGE_TAG=local

# ---- AI 助理（chat 服務：Amazon Bedrock + S3 知識庫）----
# 這些都不是機密。AWS 憑證一律由 EC2 的 IAM Role 提供，
# 千萬不要在這裡放 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY。

AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MAX_TOKENS=2048

# Bedrock 知識庫 ID（資料來源掛在 S3）。
# 這個值沿用已經在 EC2 上跑通的 AWS-s3-KB-Test，所以預設就能檢索；
# 換知識庫時改這裡即可。留空則只用模型回答、不做檢索。
KNOWLEDGE_BASE_ID=4HYLRWIZGS
KB_NUM_RESULTS=5
# managed = S3 Vectors 這類受管知識庫；vector = 自建向量庫。
# 填錯時後端會自動改用另一種再試一次。
KB_SEARCH_MODE=managed

# 留空會使用 backend/app.py 裡的預設提示詞。
SYSTEM_PROMPT=

# ---- AI 自己選資料（tool use）與指標後端 ----
# 關掉 tool use 就退回單純問答，不查數值也不檢索。
ENABLE_TOOLS=true
# 一次回答最多幾輪工具往返，避免模型反覆查詢拖時間又燒 token。
MAX_TOOL_ROUNDS=4

# local  讀 backend/curated/metrics_snapshot.json，沒有 AWS 也能跑
# athena 查 S3 curated 層；失敗會自動退回 local 並在結果標明來源
METRIC_BACKEND=local

# METRIC_BACKEND=athena 時才需要下面這些
ATHENA_DATABASE=ntpc_youth
ATHENA_WORKGROUP=primary
# 必填，否則 Athena 查詢會被拒絕
ATHENA_OUTPUT_LOCATION=
ATHENA_TIMEOUT_SECONDS=20

# ---- 每月資料更新（refresh 服務）----
# 抓到的筆數比上次掉超過這個比例時，保留舊檔不覆蓋。
# 上游真的大幅精簡資料時再放寬，例如 0.9。
FETCH_MAX_SHRINK=0.5

# ---- 管理後台（/#/admin）----
# 第一個管理員用 docker compose run --rm chat python scripts/create_admin.py 建立。
# 帳號存在 /data/admin/users.json（掛載的 volume 裡），不在 image 中。

# 純 HTTP 下必須是 false，否則瀏覽器不會送出 cookie，會變成永遠登入不了。
# 上了 HTTPS 之後請立刻改成 true。
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_MINUTES=480

# 知識庫檔案上傳的目的地。這是 KB 用的 bucket，跟資料湖那個不同。
# 留空的話後台的知識庫分頁會顯示「尚未設定」而不是壞掉。
KB_BUCKET=
KB_PREFIX=kb/docs/
# 知識庫只掛一個資料來源時可留空，後端會自動查；有多個才需要指定。
KB_DATA_SOURCE_ID=
KB_MAX_UPLOAD_MB=20
