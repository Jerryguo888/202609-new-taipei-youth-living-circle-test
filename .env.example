# Variables consumed by compose.yml. Copy to .env for local Docker runs:
#   cp .env.example .env
# On the server, CI passes these as environment variables instead, so no .env
# file is required there.

# CARTO basemap API key, inlined into the bundle at build time.
# Leave empty to build against the free/watermarked tier.
# In CI this comes from the VITE_CARTO_KEY repo secret.
VITE_CARTO_KEY=

# Host port published by the web service. The container always listens on 8080.
# Use 80 to serve the site directly, or keep 8080 behind a reverse proxy.
# In CI this comes from the optional WEB_PORT repo variable.
WEB_PORT=8080

# Image name/tag. CI sets IMAGE_TAG to the commit SHA; `local` is the default
# for developer machines.
IMAGE_NAME=nt-youth-living-circle
IMAGE_TAG=local
