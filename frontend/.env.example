# Copy this file to .env.local and fill in your own CARTO basemap API key.
# .env.local is gitignored (see .gitignore's *.local rule) and must never be committed.
VITE_CARTO_KEY=

# [Jerry 新增] AWS 上線後填入 HTTPS YouBike API；留空時使用 repo 內官方資料快照。
# API 可回傳官方陣列格式，或組員網站使用的 { "updatedAt": "...", "stations": [...] }。
VITE_YOUBIKE_API_URL=
